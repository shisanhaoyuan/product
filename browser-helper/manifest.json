{
  "manifest_version": 3,
  "name": "集物 · 商品采集助手",
  "version": "2.2.0",
  "description": "集物自有商品库采集插件：ASIN／网址采集、子变体、价格和图片，后台运行并按需设置邮编。",
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.amazon.ca/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.ca/*"
      ],
      "js": [
        "location-state.js",
        "offers.js",
        "product.js",
        "gallery.js",
        "amazon.js"
      ]
    }
  ]
}
