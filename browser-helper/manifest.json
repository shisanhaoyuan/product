{
  "manifest_version": 3,
  "name": "商品库 · 人工验证助手",
  "version": "1.1.0",
  "description": "在本机打开 Amazon，由用户完成人机验证后返回当前 ASIN 图片或卖家、价格及配送信息。",
  "permissions": ["storage", "scripting", "activeTab", "alarms"],
  "host_permissions": ["https://www.amazon.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{"matches": ["https://www.amazon.com/*"], "js": ["amazon.js"]}]
}
