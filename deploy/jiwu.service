[Unit]
Description=Jiwu team product catalog
After=network.target

[Service]
Type=simple
User=jiwu
Group=jiwu
WorkingDirectory=/www/wwwroot/jiwu
EnvironmentFile=/etc/jiwu.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/www/wwwroot/jiwu/.venv/bin/python -m catalog serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/www/server/jiwu-data

[Install]
WantedBy=multi-user.target
