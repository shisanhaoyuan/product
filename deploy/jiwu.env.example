CATALOG_AUTH_ENABLED=1
CATALOG_DATABASE_URL=postgresql://jiwu:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/jiwu
CATALOG_IMAGE_STORAGE=filesystem
CATALOG_IMAGE_ROOT=/www/server/jiwu-data/images
CATALOG_PUBLIC_ORIGIN=https://8.153.77.160
CATALOG_COOKIE_SECURE=1
# Optional additional import credential (not a replacement for team login).
# CATALOG_IMPORT_TOKEN=

# Optional GigaB2B Buyer Open API 2.0 (never commit real credentials).
# CATALOG_GIGA_ENVIRONMENT=sandbox
# CATALOG_GIGA_CLIENT_ID=
# CATALOG_GIGA_CLIENT_SECRET=

# Walmart store credentials: one master key for all shops; shop keys are bound in the UI.
# Create once with deploy/init-walmart-vault.sh. Keep an independent secure backup.
# CATALOG_CREDENTIAL_KEY_FILE=/www/server/jiwu-data/walmart-credentials.key

# Optional official item-spec override; use a Walmart-supported version, never a guessed one.
# CATALOG_WALMART_SPEC_VERSION=5.0.20260829-12_49_39-api

# Optional listing preparation AI (backend only; put real key in private /etc/jiwu.env).
# CATALOG_LISTING_AI_ENABLED=1
# CATALOG_LISTING_AI_BASE_URL=https://www.aiwanwu.cc/v1
# CATALOG_LISTING_AI_MODEL=gpt-6-astra
# CATALOG_LISTING_AI_STREAM=1
# CATALOG_LISTING_AI_KEY=

# Automatic preparation phases (default 1; requires configured AI for image analysis).
# CATALOG_LISTING_AI_VISION=1
# CATALOG_LISTING_AI_SUPPLEMENT=1
# Read-only durable feed polling; does not submit feeds or write inventory.
# CATALOG_LISTING_RESULT_WORKER=1
# Additional trusted HTTPS image hosts, comma-separated (private addresses still rejected).
# CATALOG_LISTING_IMAGE_HOSTS=

# Optional Saleyee Open API V2 (server only; see deploy/saleyee.md).
# Stable account label; do not change when rotating the AccessToken.
# CATALOG_SALEYEE_ACCOUNT=team-us
# CATALOG_SALEYEE_ACCESS_TOKEN=
